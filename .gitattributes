# Auto detect text files and perform LF normalization
* text=auto

# GitHub Linguist Overrides
# Mark compiled/inlined single-file HTML demos and data as vendored/generated so Python & TypeScript reflect accurately
*.html linguist-vendored=true
geovax-demo.html linguist-vendored=true
demo/* linguist-vendored=true
frontend/* linguist-vendored=true
out/* linguist-vendored=true
docs/* linguist-documentation=true
